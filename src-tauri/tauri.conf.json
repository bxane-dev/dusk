{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusk",
  "version": "0.4.0",
  "identifier": "dev.bxane.dusk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dusk",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local-first desktop game launcher",
    "longDescription": "Dusk scans local game libraries, launches games, tracks playtime, and organizes screenshots and collections."
  }
}
