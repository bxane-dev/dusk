{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusk",
  "version": "1.6.0",
  "identifier": "dev.bxane.dusk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dusk",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#09090b",
        "center": true,
        "decorations": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local-first desktop game launcher",
    "longDescription": "Dusk scans local game libraries, launches games, tracks playtime, and organizes screenshots and collections.",
    "publisher": "bxane",
    "category": "Utility",
    "copyright": "Copyright © 2026 bxane",
    "homepage": "https://github.com/bxane-dev/dusk",
    "license": "DOCL-1.0",
    "windows": {
      "allowDowngrades": false
    }
  }
}
